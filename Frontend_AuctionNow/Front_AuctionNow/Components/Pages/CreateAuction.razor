@page "/crear-subasta"

@using System.Net.Http.Json
@using Front_AuctionNow.Models.Requests
@using Front_AuctionNow.Models.Responses
@using Front_AuctionNow.Services
@inject UserSessionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <div class="max-w-[820px] mx-auto">
        <!-- TÍTULO DE LA SECCIÓN -->
        <div class="mb-6">
            <MudText Typo="Typo.h4" Class="font-extrabold text-slate-900 tracking-tight">
                Publicar subasta
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="text-orange-600 font-medium text-sm mt-1">
                Completá los datos de tu publicación
            </MudText>
        </div>

        <!-- CONTENEDOR PRINCIPAL DEL FORMULARIO -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 sm:p-8">
            <MudGrid Spacing="3">

                <!-- Espaciador / Categoría Dropdown -->
                <MudItem xs="12" sm="6" Class="ml-auto">
                    <MudSelect T="int"
                               Label="Categoría"
                               Variant="Variant.Outlined"
                               @bind-Value="categoriaId"
                               Class="bg-white rounded-lg">
                        @foreach (var categoria in categorias)
                        {
                            <MudSelectItem Value="@categoria.Id">
                                @categoria.Nombre
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Título -->
                <MudItem xs="12">
                    <MudTextField Label="Título"
                                  Variant="Variant.Outlined"
                                  @bind-Value="titulo"
                                  Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Descripción -->
                <MudItem xs="12">
                    <MudTextField Label="Descripción"
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  @bind-Value="descripcion"
                                  Class="bg-white rounded-lg" />
                </MudItem>

                <!-- URL de Imagen -->
                <MudItem xs="12">
                    <MudTextField Label="URL de imagen"
                                  Variant="Variant.Outlined"
                                  @bind-Value="urlImagen"
                                  Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Precio Base -->
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Precio base"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     Min="0"
                                     @bind-Value="precioBase"
                                     Class="bg-white rounded-lg font-mono" />
                </MudItem>

                <!-- Incremento Mínimo -->
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Incremento mínimo"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     Min="0"
                                     @bind-Value="incrementoMinimo"
                                     Class="bg-white rounded-lg font-mono" />
                </MudItem>

                <!-- Fecha Inicio -->
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Fecha inicio"
                                   Variant="Variant.Outlined"
                                   @bind-Date="fechaInicio"
                                   Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Hora Inicio -->
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Hora inicio"
                                   Variant="Variant.Outlined"
                                   PickerVariant="PickerVariant.Dialog"
                                   DisableToolbar="false"
                                   TimeEditMode="TimeEditMode.Normal"
                                   @bind-Time="horaInicio"
                                   Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Fecha Fin -->
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Fecha fin"
                                   Variant="Variant.Outlined"
                                   @bind-Date="fechaFin"
                                   Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Hora Fin -->
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Hora fin"
                                   Variant="Variant.Outlined"
                                   PickerVariant="PickerVariant.Dialog"
                                   DisableToolbar="false"
                                   TimeEditMode="TimeEditMode.Normal"
                                   @bind-Time="horaFin"
                                   Class="bg-white rounded-lg" />
                </MudItem>

                <!-- Botón Publicar Subasta -->
                <MudItem xs="12" Class="pt-3">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@guardando"
                               OnClick="Crear"
                               Class="py-3 font-bold text-base rounded-lg shadow-md uppercase tracking-wide">
                        @if (guardando)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        }
                        @(guardando ? "Publicando..." : "Publicar subasta")
                    </MudButton>
                </MudItem>

            </MudGrid>
        </div>
    </div>
</MudContainer>

@code {
    private IList<CategoryResponse> categorias = [];

    private int categoriaId = 1;
    private string titulo = "", descripcion = "", urlImagen = "";
    private decimal precioBase, incrementoMinimo;
    private bool guardando;

    private DateTime? fechaInicio = DateTime.Today;
    private DateTime? fechaFin = DateTime.Today.AddDays(1);
    private TimeSpan? horaInicio = DateTime.Now.TimeOfDay;
    private TimeSpan? horaFin = DateTime.Now.TimeOfDay;

    protected override async Task OnInitializedAsync()
    {
        // 1. Restaurar sesión si se recarga con F5
        if (!Sesion.EstaLogueado)
        {
            await Sesion.CargarSesion();
        }

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // 2. Cargar categorías
        try
        {
            categorias = await Http.GetFromJsonAsync<IList<CategoryResponse>>("api/v1/categorias") ?? [];
            if (categorias.Any())
            {
                categoriaId = categorias.First().Id;
            }
        }
        catch
        {
            Snackbar.Add("No se pudieron cargar las categorías.", Severity.Error);
        }
    }

    private async Task Crear()
    {
        if (string.IsNullOrWhiteSpace(titulo) ||
            precioBase <= 0 || incrementoMinimo <= 0 ||
            fechaInicio == null || fechaFin == null ||
            horaInicio == null || horaFin == null)
        {
            Snackbar.Add("Revisá los datos ingresados.", Severity.Warning);
            return;
        }

        var inicio = fechaInicio.Value.Date + horaInicio.Value;
        var fin = fechaFin.Value.Date + horaFin.Value;

        if (fin <= inicio)
        {
            Snackbar.Add("La fecha de fin debe ser posterior al inicio.", Severity.Warning);
            return;
        }

        guardando = true;

        try
        {
            if (Sesion.Usuario == null)
            {
                Snackbar.Add("Tenés que iniciar sesión.", Severity.Warning);
                Navigation.NavigateTo("/login");
                return;
            }

            var request = new CreateAuctionRequest
            {
                VendedorId = Sesion.Usuario.Id,
                CategoriaId = categoriaId,
                Titulo = titulo,
                Descripcion = descripcion,
                UrlImagen = urlImagen,
                PrecioBase = precioBase,
                IncrementoMinimo = incrementoMinimo,
                FechaInicio = inicio.ToUniversalTime(),
                FechaFin = fin.ToUniversalTime()
            };

            var response = await Http.PostAsJsonAsync("api/v1/subastas", request);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await LeerError(response), Severity.Error);
                return;
            }

            var creada = await response.Content.ReadFromJsonAsync<CreateAuctionResponse>();

            Snackbar.Add("Subasta publicada correctamente.", Severity.Success);

            Navigation.NavigateTo(
                creada == null ? "/subastas" : $"/subastas/{creada.Id}");
        }
        catch
        {
            Snackbar.Add("No se pudo crear la subasta.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task<string> LeerError(HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            return error?.Mensaje ?? "No se pudo crear la subasta.";
        }
        catch
        {
            return "No se pudo crear la subasta.";
        }
    }

    
}