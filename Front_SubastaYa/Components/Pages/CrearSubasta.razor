@page "/crear-subasta"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudText Typo="Typo.h4">Publicar subasta</MudText>
    <MudText Color="Color.Secondary" Class="mb-4">
        Completá los datos de la nueva subasta
    </MudText>

    <MudPaper Class="pa-6">

        <MudGrid>

            <MudItem xs="12">
                <MudNumericField T="int"
                                 Label="ID vendedor"
                                 Variant="Variant.Outlined"
                                 @bind-Value="vendedorId" />
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="int"
                           Label="Categoría"
                           Variant="Variant.Outlined"
                           @bind-Value="categoriaId">

                    @foreach (var categoria in categorias)
                    {
                        <MudSelectItem Value="@categoria.Id">
                            @categoria.Nombre
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Título"
                              Variant="Variant.Outlined"
                              @bind-Value="titulo" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="4"
                              @bind-Value="descripcion" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField Label="URL de imagen"
                              Variant="Variant.Outlined"
                              @bind-Value="urlImagen" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 Label="Precio base"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 @bind-Value="precioBase" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal"
                                 Label="Incremento mínimo"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 @bind-Value="incrementoMinimo" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Fecha de inicio"
                               Variant="Variant.Outlined"
                               @bind-Date="fechaInicio" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTimePicker Label="Hora de inicio"
                               Variant="Variant.Outlined"
                               @bind-Time="horaInicio" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Fecha de finalización"
                               Variant="Variant.Outlined"
                               @bind-Date="fechaFin" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTimePicker Label="Hora de finalización"
                               Variant="Variant.Outlined"
                               @bind-Time="horaFin" />
            </MudItem>

        </MudGrid>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-4"
                   Disabled="@guardando"
                   OnClick="Crear">

            @(guardando ? "Publicando..." : "Publicar subasta")

        </MudButton>

    </MudPaper>

</MudContainer>

@code {
    private IList<CategoriaResponse> categorias = [];

    private int vendedorId = 1;
    private int categoriaId = 1;

    private string titulo = "";
    private string descripcion = "";
    private string urlImagen = "";

    private decimal precioBase;
    private decimal incrementoMinimo;

    private DateTime? fechaInicio = DateTime.Today;
    private TimeSpan? horaInicio = DateTime.Now.TimeOfDay;

    private DateTime? fechaFin = DateTime.Today.AddDays(1);
    private TimeSpan? horaFin = DateTime.Now.TimeOfDay;

    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        categorias = await Http.GetFromJsonAsync<IList<CategoriaResponse>>(
            "api/v1/categorias") ?? [];
    }

    private async Task Crear()
    {
        if (string.IsNullOrWhiteSpace(titulo) ||
            fechaInicio == null || fechaFin == null ||
            horaInicio == null || horaFin == null)
        {
            Snackbar.Add("Completá los datos obligatorios.", Severity.Warning);
            return;
        }

        var inicio = fechaInicio.Value.Date + horaInicio.Value;
        var fin = fechaFin.Value.Date + horaFin.Value;

        if (fin <= inicio)
        {
            Snackbar.Add("La fecha de fin debe ser posterior al inicio.", Severity.Warning);
            return;
        }

        guardando = true;

        try
        {
            var request = new CrearSubastaRequest
            {
                VendedorId = vendedorId,
                CategoriaId = categoriaId,
                Titulo = titulo,
                Descripcion = descripcion,
                UrlImagen = urlImagen,
                PrecioBase = precioBase,
                IncrementoMinimo = incrementoMinimo,
                FechaInicio = inicio.ToUniversalTime(),
                FechaFin = fin.ToUniversalTime()
            };

            var response = await Http.PostAsJsonAsync(
                "api/v1/subastas", request);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    await response.Content.ReadAsStringAsync(),
                    Severity.Error);
                return;
            }

            var creada = await response.Content
                .ReadFromJsonAsync<CrearSubastaResponse>();

            Snackbar.Add("Subasta publicada correctamente.", Severity.Success);

            if (creada != null)
                Navigation.NavigateTo($"/subastas/{creada.Id}");
            else
                Navigation.NavigateTo("/subastas");
        }
        catch
        {
            Snackbar.Add("No se pudo crear la subasta.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}
