@page "/crear-subasta"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response
@using Front_SubastaYa.Services

@inject SesionUsuarioService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <div class="max-w-[820px] mx-auto">
        <!-- TÍTULO DE LA SECCIÓN -->
        <div class="mb-6">
            <MudText Typo="Typo.h4" Class="font-extrabold text-slate-900 tracking-tight">
                Publicar subasta
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="text-orange-600 font-medium text-sm mt-1">
                Completá los datos de tu publicación
            </MudText>
        </div>

        <!-- CONTENEDOR PRINCIPAL DEL FORMULARIO -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 sm:p-8">
            <EditForm Model="model" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <MudGrid Spacing="3">
                    <!-- Categoría Dropdown -->
                    <MudItem xs="12" sm="6" Class="ml-auto">
                        <MudSelect T="int"
                                   Label="Categoría"
                                   Variant="Variant.Outlined"
                                   @bind-Value="model.CategoriaId"
                                   Class="bg-white rounded-lg">
                            @foreach (var cat in categorias)
                            {
                                <MudSelectItem Value="@cat.Id">@cat.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Título -->
                    <MudItem xs="12">
                        <MudTextField Label="Título"
                                      Variant="Variant.Outlined"
                                      @bind-Value="model.Titulo"
                                      For="@(() => model.Titulo)"
                                      Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- Descripción -->
                    <MudItem xs="12">
                        <MudTextField Label="Descripción"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      @bind-Value="model.Descripcion"
                                      For="@(() => model.Descripcion)"
                                      Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- URL de Imagen -->
                    <MudItem xs="12">
                        <MudTextField Label="URL de imagen"
                                      Variant="Variant.Outlined"
                                      @bind-Value="model.UrlImagen"
                                      For="@(() => model.UrlImagen)"
                                      Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- Precio Base -->
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         Label="Precio base"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$"
                                         @bind-Value="model.PrecioBase"
                                         For="@(() => model.PrecioBase)"
                                         Class="bg-white rounded-lg font-mono" />
                    </MudItem>

                    <!-- Incremento Mínimo -->
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         Label="Incremento mínimo"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$"
                                         @bind-Value="model.IncrementoMinimo"
                                         For="@(() => model.IncrementoMinimo)"
                                         Class="bg-white rounded-lg font-mono" />
                    </MudItem>

                    <!-- Fecha Inicio -->
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha inicio"
                                       Variant="Variant.Outlined"
                                       @bind-Date="fechaInicio"
                                       Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- Hora Inicio -->
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="Hora inicio"
                                       Variant="Variant.Outlined"
                                       @bind-Time="horaInicio"
                                       Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- Fecha Fin -->
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha fin"
                                       Variant="Variant.Outlined"
                                       @bind-Date="fechaFin"
                                       Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- Hora Fin -->
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="Hora fin"
                                       Variant="Variant.Outlined"
                                       @bind-Time="horaFin"
                                       Class="bg-white rounded-lg" />
                    </MudItem>

                    <!-- BOTÓN PUBLICAR SUBASTA (AZUL) -->
                    <MudItem xs="12" Class="pt-3">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="@guardando"
                                   Class="py-3 font-bold text-base rounded-lg shadow-md uppercase tracking-wide">
                            @if (guardando)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                            }
                            PUBLICAR SUBASTA
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </div>
    </div>
</MudContainer>

@code {
    private CrearSubastaRequest model = new();
    private IList<CategoriaResponse> categorias = [];

    private DateTime? fechaInicio = DateTime.Today;
    private TimeSpan? horaInicio = DateTime.Now.TimeOfDay;

    private DateTime? fechaFin = DateTime.Today.AddDays(1);
    private TimeSpan? horaFin = DateTime.Now.TimeOfDay;

    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarSesion();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<IList<CategoriaResponse>>("api/v1/categorias") ?? [];
            if (categorias.Any())
            {
                model.CategoriaId = categorias.First().Id;
            }
        }
        catch
        {
            Snackbar.Add("No se pudieron cargar las categorías.", Severity.Error);
        }
    }

    private async Task Guardar()
    {
        if (!fechaInicio.HasValue || !horaInicio.HasValue || !fechaFin.HasValue || !horaFin.HasValue)
        {
            Snackbar.Add("Ingresá las fechas y horas correctamente.", Severity.Warning);
            return;
        }

        model.FechaInicio = fechaInicio.Value.Date + horaInicio.Value;
        model.FechaFin = fechaFin.Value.Date + horaFin.Value;

        if (model.FechaFin <= model.FechaInicio)
        {
            Snackbar.Add("La fecha de fin debe ser mayor a la de inicio.", Severity.Warning);
            return;
        }

        guardando = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/subastas", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Subasta creada con éxito.", Severity.Success);
                Navigation.NavigateTo("/subastas");
            }
            else
            {
                Snackbar.Add("No se pudo crear la subasta.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Ocurrió un error al guardar.", Severity.Error);
        }
        finally
        {
            guardando = false;
        }
    }
}