@page "/"
@page "/login"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response
@using Front_SubastaYa.Services
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject SesionUsuarioService Sesion
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">

    <MudPaper Class="pa-6" Elevation="2">

        <MudText Typo="Typo.h4" Class="mb-1">
            Iniciar sesión
        </MudText>

        <MudText Color="Color.Secondary" Class="mb-5">
            Ingresá a tu cuenta de SubastaYa
        </MudText>

        <MudTextField T="string"
                      Label="Email"
                      Variant="Variant.Outlined"
                      @bind-Value="email"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Contraseña"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      @bind-Value="password"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@cargando"
                   OnClick="login">

            @(cargando ? "Ingresando..." : "Ingresar")

        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-3"
                   StartIcon="@Icons.Material.Filled.Storefront"
                   OnClick="@(() => Navigation.NavigateTo("/subastas"))">

            Ver subastas

        </MudButton>
    </MudPaper>

</MudContainer>

@code {
    private string email = "";
    private string password = "";
    private bool cargando;

    private async Task login()
    {
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add(
                "Ingresá email y contraseña.",
                Severity.Warning);

            return;
        }

        cargando = true;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/v1/usuarios/login",
                new LoginRequest
                {
                    Email = email,
                    Password = password
                });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "Email o contraseña incorrectos.",
                    Severity.Error);

                return;
            }

            var usuario = await response.Content
                .ReadFromJsonAsync<LoginResponse>();

            if (usuario == null)
                return;

            await Sesion.IniciarSesion(usuario);

            Navigation.NavigateTo("/home", forceLoad: true);
        }
        catch
        {
            Snackbar.Add(
                "No se pudo conectar con la API.",
                Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }
}