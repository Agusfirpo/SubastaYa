@page "/subastas"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Response

@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    @* ============================= *@
    @* ENCABEZADO                    *@
    @* ============================= *@

    <MudText Typo="Typo.h4">
        Subastas
    </MudText>

    <MudText Typo="Typo.body1"
             Color="Color.Secondary"
             Class="mb-4">
        Encontrá y participá en subastas
    </MudText>


    @* ============================= *@
    @* FILTROS                       *@
    @* ============================= *@

    <MudPaper Class="pa-4 mb-6" Elevation="1">

        <MudGrid>

            @* ESTADO *@

            <MudItem xs="12" sm="6" md="3">

                <MudSelect T="string"
                           Label="Estado"
                           Variant="Variant.Outlined"
                           @bind-Value="estado"
                           Clearable="true">

                    <MudSelectItem T="string" Value="@("Activa")">
                        Activa
                    </MudSelectItem>

                    <MudSelectItem T="string" Value="@("Programada")">
                        Programada
                    </MudSelectItem>

                    <MudSelectItem T="string" Value="@("Finalizada")">
                        Finalizada
                    </MudSelectItem>

                    <MudSelectItem T="string" Value="@("Desierta")">
                        Desierta
                    </MudSelectItem>

                </MudSelect>

            </MudItem>


            @* CATEGORÍA *@

            <MudItem xs="12" sm="6" md="3">

                <MudSelect T="int?"
                           Label="Categoría"
                           Variant="Variant.Outlined"
                           @bind-Value="categoriaId"
                           Clearable="true">

                    @foreach (var categoria in categorias)
                    {
                        <MudSelectItem T="int?"
                                       Value="@((int?)categoria.Id)">
                            @categoria.Nombre
                        </MudSelectItem>
                    }

                </MudSelect>

            </MudItem>


            @* PRECIO MÍNIMO *@

            <MudItem xs="12" sm="6" md="2">

                <MudNumericField T="decimal?"
                                 Label="Precio mínimo"
                                 Variant="Variant.Outlined"
                                 @bind-Value="precioMinimo" />

            </MudItem>


            @* PRECIO MÁXIMO *@

            <MudItem xs="12" sm="6" md="2">

                <MudNumericField T="decimal?"
                                 Label="Precio máximo"
                                 Variant="Variant.Outlined"
                                 @bind-Value="precioMaximo" />

            </MudItem>


            @* ORDENAMIENTO *@

            <MudItem xs="12" sm="6" md="2">

                <MudSelect T="string"
                           Label="Ordenar"
                           Variant="Variant.Outlined"
                           @bind-Value="orden"
                           Clearable="true">

                    <MudSelectItem T="string"
                                   Value="@("tiempo")">
                        Menor tiempo
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("puja")">
                        Mayor puja
                    </MudSelectItem>

                </MudSelect>

            </MudItem>

        </MudGrid>


        @* BOTONES DE FILTRO *@

        <MudStack Row="true"
                  Spacing="2"
                  Class="mt-4">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="AplicarFiltros">

                Aplicar filtros

            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       OnClick="LimpiarFiltros">

                Limpiar

            </MudButton>

        </MudStack>

    </MudPaper>


    @* ============================= *@
    @* RESULTADOS                    *@
    @* ============================= *@

    @if (cargando)
    {
        <div class="d-flex justify-center mt-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

        </div>
    }
    else if (resultado == null || resultado.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info"
                  Class="mt-4">

            No se encontraron subastas.

        </MudAlert>
    }
    else
    {
        <MudGrid Class="mt-4">

            @foreach (var subasta in resultado.Items)
            {
                <MudItem xs="12"
                         sm="6"
                         md="4">

                    <MudCard Style="height: 100%;">

                        <MudCardContent>

                            <MudStack Spacing="2">

                                @* TÍTULO *@

                                <MudText Typo="Typo.h6">
                                    @subasta.Titulo
                                </MudText>


                                @* ESTADO *@

                                <div>

                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@ObtenerColorEstado(subasta.Estado)">

                                        @subasta.Estado

                                    </MudChip>

                                </div>


                                @* CATEGORÍA *@

                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary">

                                    @subasta.Categoria

                                </MudText>


                                <MudDivider />


                                @* PRECIO BASE *@

                                <MudText Typo="Typo.caption">
                                    Precio base
                                </MudText>

                                <MudText Typo="Typo.body1">
                                    $ @subasta.PrecioBase.ToString("N2")
                                </MudText>


                                @* PUJA ACTUAL *@

                                <MudText Typo="Typo.caption">
                                    Puja actual
                                </MudText>

                                <MudText Typo="Typo.h5"
                                         Color="Color.Primary">

                                    $ @subasta.PujaActual.ToString("N2")

                                </MudText>


                                @* CANTIDAD DE PUJAS *@

                                <MudText Typo="Typo.body2">

                                    @subasta.CantidadPujas
                                    @(subasta.CantidadPujas == 1
                                                                ? "puja"
                                                                : "pujas")

                                </MudText>


                                @* FECHA DE FINALIZACIÓN *@

                                <MudText Typo="Typo.body2">

                                    Finaliza:
                                    @(subasta.FechaFin
                                                                .ToLocalTime()
                                                                .ToString("dd/MM/yyyy HH:mm"))

                        </MudText>

                            </MudStack>

                        </MudCardContent>


                        <MudCardActions>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@(() => VerSubasta(subasta.Id))">

                                Ver subasta

                            </MudButton>

                        </MudCardActions>

                    </MudCard>

                </MudItem>
                }

        </MudGrid>


        @* ============================= *@
        @* PAGINACIÓN                    *@
        @* ============================= *@

        @if (resultado.TotalPaginas > 1)
        {
            <div class="d-flex justify-center mt-6 mb-6">

                <MudPagination Count="@resultado.TotalPaginas"
                               Selected="@pagina"
                               SelectedChanged="CambiarPagina"
                               ShowFirstButton="true"
                               ShowLastButton="true"
                               Color="Color.Primary" />

            </div>
        }
    }

</MudContainer>


@code {

    // =========================================
    // DATOS
    // =========================================

    private SubastasPaginadasResponse? resultado;

    private IList<CategoriaResponse> categorias =
        new List<CategoriaResponse>();


    // =========================================
    // CARGA
    // =========================================

    private bool cargando;


    // =========================================
    // FILTROS
    // =========================================

    private string? estado;

    private int? categoriaId;

    private decimal? precioMinimo;

    private decimal? precioMaximo;

    private string? orden;


    // =========================================
    // PAGINACIÓN
    // =========================================

    private int pagina = 1;

    private int tamanioPagina = 6;


    // =========================================
    // INICIALIZACIÓN
    // =========================================

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();

        await CargarSubastas();
    }


    // =========================================
    // CARGAR CATEGORÍAS
    // =========================================

    private async Task CargarCategorias()
    {
        try
        {
            var response =
                await Http.GetFromJsonAsync<IList<CategoriaResponse>>(
                    "api/v1/categorias");

            categorias =
                response ?? new List<CategoriaResponse>();
        }
        catch (Exception)
        {
            Snackbar.Add(
                "No se pudieron cargar las categorías.",
                Severity.Error);
        }
    }


    // =========================================
    // CARGAR SUBASTAS
    // =========================================

    private async Task CargarSubastas()
    {
        cargando = true;

        try
        {
            var url =
                $"api/v1/subastas" +
                $"?pagina={pagina}" +
                $"&tamanioPagina={tamanioPagina}";


            // ESTADO

            if (!string.IsNullOrWhiteSpace(estado))
            {
                url +=
                    $"&estado={Uri.EscapeDataString(estado)}";
            }


            // CATEGORÍA

            if (categoriaId.HasValue)
            {
                url +=
                    $"&categoriaId={categoriaId.Value}";
            }


            // PRECIO MÍNIMO

            if (precioMinimo.HasValue)
            {
                url +=
                    $"&precioMinimo={precioMinimo.Value}";
            }


            // PRECIO MÁXIMO

            if (precioMaximo.HasValue)
            {
                url +=
                    $"&precioMaximo={precioMaximo.Value}";
            }


            // ORDENAMIENTO

            if (!string.IsNullOrWhiteSpace(orden))
            {
                url +=
                    $"&orden={Uri.EscapeDataString(orden)}";
            }


            resultado =
                await Http.GetFromJsonAsync<SubastasPaginadasResponse>(
                    url);
        }
        catch (Exception)
        {
            Snackbar.Add(
                "No se pudieron cargar las subastas.",
                Severity.Error);

            resultado = null;
        }
        finally
        {
            cargando = false;
        }
    }


    // =========================================
    // APLICAR FILTROS
    // =========================================

    private async Task AplicarFiltros()
    {
        pagina = 1;

        await CargarSubastas();
    }


    // =========================================
    // LIMPIAR FILTROS
    // =========================================

    private async Task LimpiarFiltros()
    {
        estado = null;

        categoriaId = null;

        precioMinimo = null;

        precioMaximo = null;

        orden = null;

        pagina = 1;

        await CargarSubastas();
    }


    // =========================================
    // CAMBIAR PÁGINA
    // =========================================

    private async Task CambiarPagina(int nuevaPagina)
    {
        pagina = nuevaPagina;

        await CargarSubastas();
    }


    // =========================================
    // VER DETALLE
    // =========================================

    private void VerSubasta(int id)
    {
        Navigation.NavigateTo(
            $"/subastas/{id}");
    }


    // =========================================
    // COLOR DEL ESTADO
    // =========================================

    private Color ObtenerColorEstado(string estadoSubasta)
    {
        return estadoSubasta switch
        {
            "Activa" => Color.Success,

            "Programada" => Color.Info,

            "Finalizada" => Color.Default,

            "Desierta" => Color.Warning,

            _ => Color.Default
        };
    }
}