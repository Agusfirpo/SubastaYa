@page "/billetera"
@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response
@using Front_SubastaYa.Services
@inject SesionUsuarioService Sesion
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>SubastaYa - Mi Billetera</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    @if (cargando && billetera == null)
    {
        <div class="flex justify-center items-center py-36">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (billetera != null)
    {
        <!-- Header de la página -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-white/90 backdrop-blur-md px-2.5 py-0.5 rounded-md border border-white/80 shadow-xs">
                        Banca Digital
                    </span>
                    <span class="text-xs text-slate-400">•</span>
                    <span class="text-xs text-slate-600 font-medium">Actualizado en tiempo real</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight m-0">Mi billetera</h1>
            </div>
            <div class="flex items-center gap-2 self-start sm:self-auto">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/15 backdrop-blur-md text-emerald-800 text-xs font-bold border border-emerald-500/30 shadow-xs">
                    <span class="material-symbols-outlined text-emerald-600 text-sm">verified</span>
                    Cuenta Activa
                </span>
            </div>
        </div>

        <!-- Grid Asimétrico (65% / 35%) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- Columna Izquierda (Finanzas y Movimientos) -->
            <div class="lg:col-span-8 space-y-6">

                <!-- HERO CARD: Saldo Disponible -->
                <div class="hero-wallet-card rounded-2xl p-6 sm:p-7 text-white shadow-xl relative overflow-hidden">
                    <div class="balance-glow-1"></div>
                    <div class="balance-glow-2"></div>
                    <div class="balance-watermark">
                        <span class="material-symbols-outlined watermark-icon">gavel</span>
                    </div>

                    <div class="relative z-10">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                            <div class="flex items-center space-x-2">
                                <span class="text-xs font-bold tracking-wider text-slate-300 uppercase">Saldo Disponible para Pujas</span>
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
                                    Inmediato
                                </span>
                            </div>
                            <span class="text-xs text-slate-400 font-mono">Usuario #@usuarioId</span>
                        </div>

                        <div class="flex items-baseline space-x-2 mb-6">
                            <span class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white font-mono">
                                $ @billetera.SaldoDisponible.ToString("N2")
                            </span>
                            <span class="text-xs font-bold text-blue-200 uppercase tracking-widest ml-1 bg-blue-500/25 border border-blue-400/30 px-2 py-0.5 rounded">ARS</span>
                        </div>

                        <div class="pt-2 flex flex-wrap items-center justify-between gap-3">
                            <button type="button"
                                    class="btn-action-hero inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white text-xs sm:text-sm font-bold tracking-wide shadow-lg shadow-blue-600/35 transition-all gap-2 cursor-pointer"
                                    @onclick="FocusMonto">
                                <span class="material-symbols-outlined text-base">add</span>
                                Ingresar dinero
                            </button>

                            <div class="hidden sm:flex items-center text-xs text-slate-300/90 gap-1.5">
                                <span class="material-symbols-outlined text-blue-400 text-base">info</span>
                                <span>Garantías activadas con 1-click</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Métricas Secundarias -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                    <!-- Retenido / En Garantía -->
                    <div class="glass-metric-card">
                        <div class="h-1 bg-amber-400 absolute top-0 left-0 right-0"></div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2.5">
                                <div class="w-8 h-8 rounded-lg bg-amber-500/15 text-amber-600 flex items-center justify-center border border-amber-500/30">
                                    <span class="material-symbols-outlined text-lg">lock</span>
                                </div>
                                <span class="text-xs font-bold text-slate-600 uppercase tracking-wide">En Garantía (Retenido)</span>
                            </div>
                            <span class="text-[11px] font-bold text-amber-700 bg-amber-100/80 px-2.5 py-0.5 rounded-full border border-amber-300/70">
                                Bloqueado
                            </span>
                        </div>

                        <div class="mt-4">
                            <div class="text-2xl font-black text-slate-900 tracking-tight font-mono">
                                $ @billetera.SaldoRetenido.ToString("N2")
                            </div>
                            <p class="text-xs text-slate-600 mt-1.5 flex items-center gap-1.5 m-0 font-medium">
                                <span class="material-symbols-outlined text-sm text-emerald-600">check_circle</span>
                                Respaldando tus ofertas activas
                            </p>
                        </div>
                    </div>

                    <!-- Saldo Total en Cuenta -->
                    <div class="glass-metric-card">
                        <div class="h-1 bg-blue-600 absolute top-0 left-0 right-0"></div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2.5">
                                <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center border border-blue-500/20">
                                    <span class="material-symbols-outlined text-lg">account_balance</span>
                                </div>
                                <span class="text-xs font-bold text-slate-600 uppercase tracking-wide">Saldo Total en Cuenta</span>
                            </div>
                            <span class="text-[11px] font-bold text-slate-700 bg-slate-200/80 px-2.5 py-0.5 rounded-full border border-slate-300">
                                ARS
                            </span>
                        </div>

                        <div class="mt-4">
                            <div class="text-2xl font-black text-slate-900 tracking-tight font-mono">
                                $ @billetera.SaldoTotal.ToString("N2")
                            </div>
                            <p class="text-xs text-slate-600 mt-1.5 m-0 font-medium">
                                Disponible + Garantías vigentes
                            </p>
                        </div>
                    </div>

                </div>

                <!-- Tabla de Movimientos -->
                <div class="glass-panel-card rounded-2xl overflow-hidden shadow-sm">
                    <div class="p-5 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900 m-0">Movimientos de la cuenta</h2>
                            <p class="text-xs text-slate-500 mt-1 m-0">Historial completo de depósitos, pagos y retenciones</p>
                        </div>
                        <span class="text-xs font-bold text-slate-600 bg-white/90 px-3 py-1 rounded-full border border-slate-200 shadow-xs">
                            @transacciones.Count registros
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200/70 text-left text-sm">
                            <thead>
                                <tr class="bg-slate-50/90 text-slate-500 text-[11px] font-bold uppercase tracking-wider">
                                    <th class="py-3 px-5" scope="col">Concepto / Tipo</th>
                                    <th class="py-3 px-4" scope="col">Subasta</th>
                                    <th class="py-3 px-4" scope="col">Fecha y Hora</th>
                                    <th class="py-3 px-5 text-right" scope="col">Monto</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200/60 text-slate-700">
                                @if (transacciones.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="py-10 text-center text-slate-400 text-sm">
                                            No hay movimientos registrados en la cuenta.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var t in transacciones)
                                    {
                                        <tr class="tx-table-row transition-colors">
                                            <td class="py-3.5 px-5">
                                                <div class="flex items-center space-x-3">
                                                    <div class="@ObtenerIconoContenedorClase(t.Tipo)">
                                                        <span class="material-symbols-outlined text-lg">@ObtenerIconoTipo(t.Tipo)</span>
                                                    </div>
                                                    <div>
                                                        <div class="font-bold text-slate-900 flex items-center gap-2">
                                                            <span>@t.Tipo</span>
                                                            <span class="@ObtenerChipClase(t.Tipo)">
                                                                @t.Tipo
                                                            </span>
                                                        </div>
                                                        <span class="text-xs text-slate-400">@ObtenerDescripcionOperacion(t.Tipo)</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3.5 px-4 text-xs font-bold text-blue-600">
                                                @if (t.SubastaId.HasValue)
                                                {
                                                    <a class="inline-flex items-center gap-1 hover:underline" href="/subastas/@t.SubastaId">
                                                        #@t.SubastaId
                                                        <span class="material-symbols-outlined text-xs text-slate-400">open_in_new</span>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400 font-normal">-</span>
                                                }
                                            </td>
                                            <td class="py-3.5 px-4 text-xs text-slate-500 whitespace-nowrap">
                                                @t.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td class="py-3.5 px-5 text-right font-bold font-mono text-sm whitespace-nowrap @ObtenerMontoClase(t.Tipo)">
                                                @ObtenerSignoMonto(t.Tipo) $ @t.Monto.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Acreditar Saldo & Ayuda -->
            <div class="lg:col-span-4 space-y-6">

                <!-- Tarjeta: Formulario de Depósito -->
                <div class="glass-panel-card rounded-2xl p-6 relative overflow-hidden shadow-sm">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h3 class="text-base font-bold text-slate-900 m-0">Acreditar saldo</h3>
                            <p class="text-xs text-slate-500 mt-0.5 m-0">Acreditación instantánea 24/7</p>
                        </div>
                        <div class="w-9 h-9 rounded-xl bg-blue-500/15 text-blue-600 flex items-center justify-center border border-blue-500/20">
                            <span class="material-symbols-outlined text-xl">add_card</span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5" for="monto-input">
                                Monto a ingresar (ARS)
                            </label>
                            <MudNumericField @ref="campoMonto"
                                             T="decimal?"
                                             @bind-Value="monto"
                                             Placeholder="0,00"
                                             Min="0"
                                             Format="N2"
                                             Adornment="Adornment.Start"
                                             AdornmentText="$"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="monto-numeric-field bg-white/90 rounded-xl" />
                        </div>

                        <div>
                            <span class="text-[11px] font-semibold text-slate-600 block mb-1.5">Sugerencias rápidas:</span>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button"
                                        class="preset-btn @(monto == 10000 ? "preset-btn-active" : "")"
                                        @onclick="() => SeleccionarSugerencia(10000)">
                                    +$10.000
                                </button>
                                <button type="button"
                                        class="preset-btn @(monto == 50000 ? "preset-btn-active" : "")"
                                        @onclick="() => SeleccionarSugerencia(50000)">
                                    +$50.000
                                </button>
                                <button type="button"
                                        class="preset-btn @(monto == 100000 ? "preset-btn-active" : "")"
                                        @onclick="() => SeleccionarSugerencia(100000)">
                                    +$100.000
                                </button>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="button"
                                    class="w-full flex items-center justify-center px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-extrabold text-sm tracking-wider uppercase shadow-lg shadow-blue-600/30 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                                    disabled="@(depositando || monto.GetValueOrDefault() <= 0)"
                                    @onclick="Depositar">
                                @if (depositando)
                                {
                                    <span>Depositando...</span>
                                }
                                else
                                {
                                    <span>DEPOSITAR @(monto.GetValueOrDefault() > 0 ? $"$ {monto.GetValueOrDefault():N0}" : "")</span>
                                }
                            </button>
                        </div>

                        <div class="flex items-center justify-center space-x-2 pt-1 text-[11px] text-slate-600">
                            <span class="material-symbols-outlined text-emerald-600 text-sm">verified_user</span>
                            <span>Transacción cifrada y protegida</span>
                        </div>
                    </div>
                </div>

                <!-- Widget Informativo de Garantía -->
                <div class="glass-panel-card rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-8 h-8 rounded-lg bg-blue-500/15 text-blue-600 flex items-center justify-center shrink-0 border border-blue-500/20">
                            <span class="material-symbols-outlined text-base">help</span>
                        </div>
                        <h4 class="font-bold text-slate-900 text-sm m-0">¿Cómo funciona la Garantía?</h4>
                    </div>

                    <div class="space-y-3.5 text-xs text-slate-600 leading-relaxed">
                        <div class="flex items-start space-x-2.5">
                            <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">1</span>
                            <p class="m-0"><strong class="text-slate-900 font-semibold">Al ofertar:</strong> se retiene temporalmente el saldo necesario para respaldar la puja.</p>
                        </div>
                        <div class="flex items-start space-x-2.5">
                            <span class="w-5 h-5 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">2</span>
                            <p class="m-0"><strong class="text-slate-900 font-semibold">Si te superan:</strong> se libera de inmediato a tu Saldo Disponible.</p>
                        </div>
                        <div class="flex items-start space-x-2.5">
                            <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">3</span>
                            <p class="m-0"><strong class="text-slate-900 font-semibold">Si ganas:</strong> el importe retenido se aplica al pago final de la adjudicación.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    private MudNumericField<decimal?>? campoMonto;
    private int usuarioId => Sesion.Usuario?.Id ?? 0;
    private decimal? monto = null;
    private bool cargando;
    private bool depositando;
    private BilleteraResponse? billetera;
    private IList<TransaccionResponse> transacciones = [];

    protected override async Task OnInitializedAsync()
    {
        // 1. Si no hay sesión en memoria, restaurarla del almacenamiento local
        if (!Sesion.EstaLogueado)
        {
            await Sesion.CargarSesion();
        }

        // 2. Si sigue sin estar logueado, enviar al login
        if (!Sesion.EstaLogueado || usuarioId <= 0)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // 3. Ya con el usuario cargado y su ID real, pedir la billetera
        await CargarTodo();
    }

    private async Task CargarTodo()
    {
        if (usuarioId <= 0) return;

        cargando = true;
        try
        {
            var tBilletera = Http.GetFromJsonAsync<BilleteraResponse>($"api/v1/usuarios/{usuarioId}/billetera");
            var tTransacciones = Http.GetFromJsonAsync<IList<TransaccionResponse>>($"api/v1/usuarios/{usuarioId}/billetera/transacciones");

            await Task.WhenAll(tBilletera, tTransacciones);

            billetera = await tBilletera;
            transacciones = (await tTransacciones) ?? [];
        }
        catch
        {
            Snackbar.Add("No se pudo cargar la billetera.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void SeleccionarSugerencia(decimal valor) => monto = valor;

    private async Task FocusMonto()
    {
        if (monto.GetValueOrDefault() == 0) monto = 10000;
        if (campoMonto != null)
        {
            await campoMonto.FocusAsync();
        }
    }

    private async Task Depositar()
    {
        var valorMonto = monto.GetValueOrDefault();

        if (valorMonto <= 0)
        {
            Snackbar.Add("El monto debe ser mayor a cero.", Severity.Warning);
            return;
        }

        depositando = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/v1/usuarios/{usuarioId}/billetera/depositos",
                new AcreditarSaldoRequest { Monto = valorMonto });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo acreditar el saldo.", Severity.Error);
                return;
            }

            monto = null;
            Snackbar.Add("Saldo acreditado correctamente.", Severity.Success);
            await CargarTodo();
        }
        catch
        {
            Snackbar.Add("No se pudo conectar con la API.", Severity.Error);
        }
        finally
        {
            depositando = false;
        }
    }

    private string ObtenerIconoTipo(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "payments",
        var t when t.Contains("reten") => "lock_clock",
        var t when t.Contains("liber") => "lock_open",
        _ => "account_balance_wallet"
    };

    private string ObtenerIconoContenedorClase(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 shadow-xs border border-slate-200",
        var t when t.Contains("reten") => "w-9 h-9 rounded-xl bg-amber-100/90 text-amber-600 flex items-center justify-center shrink-0 shadow-xs border border-amber-200",
        var t when t.Contains("liber") => "w-9 h-9 rounded-xl bg-emerald-100/90 text-emerald-600 flex items-center justify-center shrink-0 shadow-xs border border-emerald-200",
        _ => "w-9 h-9 rounded-xl bg-blue-100/90 text-blue-600 flex items-center justify-center shrink-0 shadow-xs border border-blue-200"
    };

    private string ObtenerChipClase(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200",
        var t when t.Contains("reten") => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200",
        var t when t.Contains("liber") => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200",
        _ => "inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200"
    };

    private string ObtenerMontoClase(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "text-slate-800",
        var t when t.Contains("liber") || t.Contains("deposito") => "text-emerald-600 font-extrabold",
        var t when t.Contains("reten") => "text-amber-600",
        _ => "text-slate-900"
    };

    private string ObtenerSignoMonto(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "-",
        var t when t.Contains("liber") || t.Contains("deposito") => "+",
        _ => ""
    };

    private string ObtenerDescripcionOperacion(string tipo) => tipo.ToLower() switch
    {
        var t when t.Contains("reten") => "Garantía de oferta",
        var t when t.Contains("liber") => "Garantía liberada",
        var t when t.Contains("pago") || t.Contains("debito") || t.Contains("cobra") => "Pago de adjudicación",
        _ => "Operación de billetera"
    };
}