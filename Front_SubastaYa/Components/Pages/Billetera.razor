@page "/billetera"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response

@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudText Typo="Typo.h4" Class="mb-4">
        Mi billetera
    </MudText>

    <MudStack Row="true" Class="mb-4">
        <MudNumericField T="int"
                         Label="Usuario"
                         @bind-Value="usuarioId" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="CargarTodo">
            Consultar
        </MudButton>
    </MudStack>

    @if (cargando)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (billetera != null)
    {
        <MudGrid>

            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.caption">Saldo total</MudText>
                    <MudText Typo="Typo.h6">
                        $ @billetera.SaldoTotal.ToString("N2")
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.caption">Retenido</MudText>
                    <MudText Typo="Typo.h6">
                        $ @billetera.SaldoRetenido.ToString("N2")
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.caption">Disponible</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">
                        $ @billetera.SaldoDisponible.ToString("N2")
                    </MudText>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <MudPaper Class="pa-4 mt-4">

            <MudText Typo="Typo.h6" Class="mb-3">
                Acreditar saldo
            </MudText>

            <MudNumericField T="decimal"
                             Label="Monto"
                             Adornment="Adornment.Start"
                             AdornmentText="$"
                             @bind-Value="monto" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3"
                       Disabled="@depositando"
                       OnClick="Depositar">

                @(depositando ? "Depositando..." : "Depositar")

            </MudButton>

        </MudPaper>

        <MudText Typo="Typo.h5" Class="mt-6 mb-3">
            Movimientos
        </MudText>

        <MudTable Items="@transacciones" Hover="true">

            <HeaderContent>
                <MudTh>Tipo</MudTh>
                <MudTh>Monto</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Subasta</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.Tipo</MudTd>
                <MudTd>$ @context.Monto.ToString("N2")</MudTd>
                <MudTd>
                    @context.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </MudTd>
                <MudTd>@(context.SubastaId?.ToString() ?? "-")</MudTd>
            </RowTemplate>

        </MudTable>
    }

</MudContainer>

@code {
    private int usuarioId = 2;
    private decimal monto;
    private bool cargando;
    private bool depositando;

    private BilleteraResponse? billetera;
    private IList<TransaccionResponse> transacciones = [];

    protected override async Task OnInitializedAsync()
        => await CargarTodo();

    private async Task CargarTodo()
    {
        cargando = true;

        try
        {
            billetera = await Http.GetFromJsonAsync<BilleteraResponse>(
                $"api/v1/usuarios/{usuarioId}/billetera");

            transacciones = await Http.GetFromJsonAsync<IList<TransaccionResponse>>(
                $"api/v1/usuarios/{usuarioId}/billetera/transacciones") ?? [];
        }
        catch
        {
            Snackbar.Add("No se pudo cargar la billetera.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Depositar()
    {
        if (monto <= 0)
        {
            Snackbar.Add("El monto debe ser mayor a cero.", Severity.Warning);
            return;
        }

        depositando = true;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/v1/usuarios/{usuarioId}/billetera/depositos",
                new AcreditarSaldoRequest { Monto = monto });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("No se pudo acreditar el saldo.", Severity.Error);
                return;
            }

            monto = 0;
            Snackbar.Add("Saldo acreditado correctamente.", Severity.Success);

            await CargarTodo();
        }
        catch
        {
            Snackbar.Add("No se pudo conectar con la API.", Severity.Error);
        }
        finally
        {
            depositando = false;
        }
    }
}