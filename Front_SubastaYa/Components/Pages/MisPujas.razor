@page "/mis-pujas"

@using System.Net.Http.Json
@using Aplicacion.DTOs.Response
@using Front_SubastaYa.Services
@inject SesionUsuarioService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <MudText Typo="Typo.h4">Mis compras / pujas</MudText>
    <MudText Color="Color.Secondary" Class="mb-4">
        Subastas en las que participaste
    </MudText>

    <MudStack Row="true" Class="mb-4">
        

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Cargar">
            Consultar
        </MudButton>
    </MudStack>

    @if (cargando)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (participaciones.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            El usuario todavía no participó en subastas.
        </MudAlert>
    }
    else
    {
        <MudTable Items="@participaciones" Hover="true">

            <HeaderContent>
                <MudTh>Subasta</MudTh>
                <MudTh>Mi puja</MudTh>
                <MudTh>Puja actual</MudTh>
                <MudTh>Resultado</MudTh>
                <MudTh>Finaliza</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>
                    <strong>@context.Titulo</strong>
                    <br />
                    <small>@context.EstadoSubasta</small>
                </MudTd>

                <MudTd>
                    $ @context.MiUltimaPuja.ToString("N2")
                </MudTd>

                <MudTd>
                    $ @context.PujaActual.ToString("N2")
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@ColorResultado(context.Resultado)">
                        @context.Resultado
                    </MudChip>
                </MudTd>

                <MudTd>
                    @context.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </MudTd>

                <MudTd>
                    <MudButton Size="Size.Small"
                               OnClick="@(() => Ver(context.SubastaId))">
                        Ver
                    </MudButton>
                </MudTd>

            </RowTemplate>

        </MudTable>
    }

</MudContainer>

@code {
    private int usuarioId => Sesion.Usuario?.Id ?? 0;
    private bool cargando;
    private IList<ParticipacionResponse> participaciones = [];

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;

        try
        {
            participaciones = await Http.GetFromJsonAsync<IList<ParticipacionResponse>>($"api/v1/usuarios/{usuarioId}/pujas") ?? [];
        }
        catch
        {
            participaciones = [];

            Snackbar.Add("No se pudieron cargar las pujas.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void Ver(int id)
        => Navigation.NavigateTo($"/subastas/{id}");

    private Color ColorResultado(string resultado) => resultado switch
    {
        "Ganada" => Color.Success,
        "Liderando" => Color.Success,
        "Superado" => Color.Warning,
        _ => Color.Default
    };
}
