@page "/subastas/{Id:int}"

@using System.Net
@using System.Net.Http.Json
@using Aplicacion.DTOs.Request
@using Aplicacion.DTOs.Response
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar



<MudPaper Class="pa-4 mb-4" Elevation="0">

    <MudText Typo="Typo.caption">
        Tiempo restante
    </MudText>

    <MudText Typo="Typo.h4"
             Color="@ColorTemporizador()">

        @TextoTemporizador()

    </MudText>

</MudPaper>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    @* ============================= *@
    @* BOTÓN VOLVER                  *@
    @* ============================= *@

    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Variant="Variant.Text"
               OnClick="Volver">
        Volver a subastas
    </MudButton>


    @* ============================= *@
    @* ESTADO DE CARGA               *@
    @* ============================= *@

    @if (cargando)
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }

    @* ============================= *@
    @* SUBASTA NO ENCONTRADA         *@
    @* ============================= *@

    else if (subasta == null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            No se encontró la subasta.
        </MudAlert>
    }

    @* ============================= *@
    @* SUBASTA ENCONTRADA            *@
    @* ============================= *@

    else
    {
        <MudGrid Class="mt-4">

            @* ============================= *@
            @* DETALLE DE LA SUBASTA         *@
            @* ============================= *@

            <MudItem xs="12" md="8">

                <MudPaper Class="pa-6" Elevation="1">

                    <MudStack Spacing="3">

                        <div class="d-flex justify-space-between align-center">

                            <MudText Typo="Typo.h4">
                                @subasta.Titulo
                            </MudText>

                            <MudChip T="string"
                                     Color="@ObtenerColorEstado(subasta.Estado)">
                                @subasta.Estado
                            </MudChip>

                        </div>

                        <MudText Color="Color.Secondary">
                            @subasta.Categoria
                        </MudText>

                        <MudText>
                            @subasta.Descripcion
                        </MudText>

                        <MudDivider />

                        @* PRECIOS Y PUJAS *@

                        <MudGrid>

                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Precio base</MudText>
                                <MudText Typo="Typo.h6">
                                    $ @subasta.PrecioBase.ToString("N2")
                                </MudText>
                            </MudItem>

                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Puja actual</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Primary">
                                    $ @subasta.PujaActual.ToString("N2")
                                </MudText>
                            </MudItem>

                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Incremento mínimo</MudText>
                                <MudText Typo="Typo.h6">
                                    $ @subasta.IncrementoMinimo.ToString("N2")
                                </MudText>
                            </MudItem>

                            <MudItem xs="6">
                                <MudText Typo="Typo.caption">Cantidad de pujas</MudText>
                                <MudText Typo="Typo.h6">
                                    @subasta.CantidadPujas
                                </MudText>
                            </MudItem>

                        </MudGrid>

                        <MudDivider />

                        @* VENDEDOR Y FECHAS *@

                        <MudText>
                            Vendedor: <strong>@subasta.Vendedor</strong>
                        </MudText>

                        <MudText>
                            Inicio:
                            @(subasta.FechaInicio.ToLocalTime()
                                                    .ToString("dd/MM/yyyy HH:mm"))
                                                                              </MudText>

                        <MudText>
                            Finaliza:
                            @(subasta.FechaFin.ToLocalTime()
                                                    .ToString("dd/MM/yyyy HH:mm"))
                    </MudText>

                    </MudStack>

                </MudPaper>

            </MudItem>


            @* ============================= *@
            @* PANEL PARA REALIZAR PUJA      *@
            @* ============================= *@

            <MudItem xs="12" md="4">

                <MudPaper Class="pa-6" Elevation="1">

                    <MudText Typo="Typo.h5" Class="mb-4">
                        Realizar puja
                    </MudText>


                  

                    @* SOLO PERMITIMOS PUJAR SI ESTÁ ACTIVA *@

                    @if (Participo())
                    {
                        <MudAlert Severity="@(EsLider() ? Severity.Success : Severity.Warning)"
                                  Class="mb-3">

                            @(EsLider()
                                ? "Estás liderando esta subasta"
                                : "Tu oferta fue superada")

                        </MudAlert>
                    }

                @if (subasta.Estado == "Activa")
                    {
                        <MudNumericField T="int"
                                         Label="ID comprador"
                                         Variant="Variant.Outlined"
                                         @bind-Value="compradorId"
                                         Min="1"
                                         Class="mb-3" />

                        <MudNumericField T="decimal"
                                         Label="Monto"
                                         Variant="Variant.Outlined"
                                         @bind-Value="montoPuja"
                                         Min="0"
                                         Adornment="Adornment.Start"
                                         AdornmentText="$"
                                         Class="mb-3" />

                        <MudText Typo="Typo.caption" Class="mb-4">
                            Puja mínima:
                            $ @CalcularPujaMinima().ToString("N2")
                        </MudText>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="@enviandoPuja"
                                   OnClick="RealizarPuja">

                            @if (enviandoPuja)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Class="mr-2" />
                            }

                            Ofertar

                        </MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">
                            Esta subasta no se encuentra activa.
                        </MudAlert>
                    }

                </MudPaper>

            </MudItem>

        </MudGrid>


        @* ============================= *@
        @* HISTORIAL DE PUJAS            *@
        @* ============================= *@

        <MudPaper Class="pa-6 mt-6 mb-6" Elevation="1">

            <MudText Typo="Typo.h5" Class="mb-4">
                Historial de pujas
            </MudText>

            @if (cargandoPujas)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (pujas.Count == 0)
            {
                <MudAlert Severity="Severity.Info">
                    Esta subasta todavía no recibió pujas.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@pujas" Hover="true" Dense="true">

                    <HeaderContent>
                        <MudTh>Usuario</MudTh>
                        <MudTh>Monto</MudTh>
                        <MudTh>Fecha</MudTh>
                    </HeaderContent>

                    <RowTemplate>

                        <MudTd DataLabel="Usuario">
                            @context.Usuario
                        </MudTd>

                        <MudTd DataLabel="Monto">
                            $ @context.Monto.ToString("N2")
                        </MudTd>

                        <MudTd DataLabel="Fecha">
                            @(context.FechaPuja.ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm:ss"))
                </MudTd>

                    </RowTemplate>

                </MudTable>
                }

        </MudPaper>
    }

</MudContainer>


@code {

    private TimeSpan tiempoRestante;
    private CancellationTokenSource? temporizadorCts;

    // =========================================
    // ID QUE RECIBIMOS DESDE /subastas/{id}
    // =========================================

    [Parameter]
    public int Id { get; set; }


    // =========================================
    // DATOS DE LA PÁGINA
    // =========================================
    private HubConnection? hubConnection;
    private DetalleSubastaResponse? subasta;

    private IList<PujaResponse> pujas = new List<PujaResponse>();


    // =========================================
    // VARIABLES PARA MOSTRAR CARGA
    // =========================================

    private bool cargando = true;
    private bool cargandoPujas = true;
    private bool enviandoPuja;


    // =========================================
    // DATOS DEL FORMULARIO DE PUJA
    // =========================================

    // Temporal hasta que tengamos usuario logueado.
    private int compradorId = 3;

    private decimal montoPuja;


    // =========================================
    // CUANDO ABRIMOS /subastas/{id}
    // =========================================

    protected override async Task OnParametersSetAsync()
    {
        await CargarSubasta();

        if (subasta == null)
            return;

        await CargarPujas();

        montoPuja = CalcularPujaMinima();

        IniciarTemporizador();
        await ConectarSignalR();
    }


    // =========================================
    // GET /api/v1/subastas/{id}
    // =========================================

    private async Task CargarSubasta()
    {
        cargando = true;

        try
        {
            subasta = await Http.GetFromJsonAsync<DetalleSubastaResponse>(
                $"api/v1/subastas/{Id}");
        }
        catch (HttpRequestException ex)
            when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            subasta = null;
        }
        catch
        {
            Snackbar.Add("No se pudo cargar la subasta.", Severity.Error);
            subasta = null;
        }
        finally
        {
            cargando = false;
        }
    }


    // =========================================
    // GET /api/v1/subastas/{id}/pujas
    // =========================================

    private async Task CargarPujas()
    {
        cargandoPujas = true;

        try
        {
            pujas = await Http.GetFromJsonAsync<IList<PujaResponse>>(
                $"api/v1/subastas/{Id}/pujas")
                ?? new List<PujaResponse>();
        }
        catch
        {
            Snackbar.Add(
                "No se pudo cargar el historial.",
                Severity.Error);
        }
        finally
        {
            cargandoPujas = false;
        }
    }

    private async Task ConectarSignalR()
    {
        if (hubConnection != null)
            return;

        hubConnection = new HubConnectionBuilder()
            .WithUrl(new Uri(Http.BaseAddress!, "hubs/subastas"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<JsonElement>("NuevaPuja", async evento =>
    {
       var extendida =
        evento.TryGetProperty("tiempoExtendido", out var valor) &&
        valor.GetBoolean();

         await CargarSubasta();
         await CargarPujas();

         ActualizarTiempo();

        if (subasta != null)
        montoPuja = CalcularPujaMinima();

        if (extendida)
        {
        Snackbar.Add(
            "La subasta fue extendida 2 minutos por anti-sniping.",
            Severity.Warning);
        }

         await InvokeAsync(StateHasChanged);
    });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("UnirseASubasta", Id);
    }



    // =========================================
    // CALCULAR MONTO MÍNIMO
    // =========================================

    private decimal CalcularPujaMinima()
    {
        if (subasta == null)
            return 0;

        return subasta.CantidadPujas == 0
            ? subasta.PrecioBase
            : subasta.PujaActual + subasta.IncrementoMinimo;
    }

    private bool Participo()
    => pujas.Any(p =>
        p.Usuario == $"Usuario***{compradorId}");

    private bool EsLider()
    {
        var mayor = pujas
            .OrderByDescending(p => p.Monto)
            .FirstOrDefault();

        return mayor?.Usuario ==
               $"Usuario***{compradorId}";
    }


    // =========================================
    // POST /api/v1/subastas/{id}/pujas
    // =========================================

    private async Task RealizarPuja()
    {
        if (subasta == null)
            return;

        var minimo = CalcularPujaMinima();

        if (compradorId <= 0)
        {
            Snackbar.Add("Comprador inválido.", Severity.Warning);
            return;
        }

        if (montoPuja < minimo)
        {
            Snackbar.Add(
                $"La puja mínima es $ {minimo:N2}.",
                Severity.Warning);

            return;
        }

        enviandoPuja = true;

        try
        {
            var request = new RealizarPujaRequest
            {
                CompradorId = compradorId,
                Monto = montoPuja
            };

            var response = await Http.PostAsJsonAsync(
                $"api/v1/subastas/{Id}/pujas",
                request);

            if (!response.IsSuccessStatusCode)
            {
                var mensaje = await ObtenerMensajeError(response);

                Snackbar.Add(
                    mensaje,
                    response.StatusCode == HttpStatusCode.Conflict
                        ? Severity.Warning
                        : Severity.Error);

                return;
            }

            Snackbar.Add(
                "Puja realizada correctamente.",
                Severity.Success);

            // Actualizamos pantalla después de pujar.
            await CargarSubasta();
            await CargarPujas();

            montoPuja = CalcularPujaMinima();
        }
        catch
        {
            Snackbar.Add(
                "Ocurrió un error al realizar la puja.",
                Severity.Error);
        }
        finally
        {
            enviandoPuja = false;
        }
    }


    // =========================================
    // LEER EL MENSAJE QUE DEVUELVE LA API
    // =========================================

    private async Task<string> ObtenerMensajeError(
        HttpResponseMessage response)
    {
        try
        {
            var error = await response.Content
                .ReadFromJsonAsync<ErrorResponse>();

            if (!string.IsNullOrWhiteSpace(error?.Mensaje))
                return error.Mensaje;
        }
        catch
        {
        }

        return "No se pudo realizar la puja.";
    }


    // =========================================
    // VOLVER AL CATÁLOGO
    // =========================================

    private void Volver()
        => Navigation.NavigateTo("/subastas");


    // =========================================
    // COLOR DEL ESTADO
    // =========================================

    private Color ObtenerColorEstado(string estado)
        => estado switch
        {
            "Activa" => Color.Success,
            "Programada" => Color.Info,
            "Desierta" => Color.Warning,
            _ => Color.Default
        };

        
    // La API devuelve errores como:
    // { "mensaje": "Saldo insuficiente." }

    private class ErrorResponse
    {
        public string Mensaje { get; set; } = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        temporizadorCts?.Cancel();
        temporizadorCts?.Dispose();

        if (hubConnection == null)
            return;

        if (hubConnection.State == HubConnectionState.Connected)
            await hubConnection.InvokeAsync("SalirDeSubasta", Id);

        await hubConnection.DisposeAsync();
    }
    private void IniciarTemporizador()
    {
        temporizadorCts?.Cancel();
        temporizadorCts = new CancellationTokenSource();

        ActualizarTiempo();
        _ = EjecutarTemporizador(temporizadorCts.Token);
    }

    private async Task EjecutarTemporizador(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

            while (await timer.WaitForNextTickAsync(token))
            {
                ActualizarTiempo();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void ActualizarTiempo()
    {
        if (subasta == null)
            return;

        var restante = subasta.FechaFin.ToLocalTime() - DateTime.Now;

        tiempoRestante = restante > TimeSpan.Zero
            ? restante
            : TimeSpan.Zero;
    }

    private string TextoTemporizador()
    {
        if (tiempoRestante <= TimeSpan.Zero)
            return "Finalizada";

        return $"{(int)tiempoRestante.TotalHours:00}:" +
               $"{tiempoRestante.Minutes:00}:" +
               $"{tiempoRestante.Seconds:00}";
    }

    private Color ColorTemporizador()
    {
        if (tiempoRestante <= TimeSpan.FromSeconds(30))
            return Color.Error;

        if (tiempoRestante <= TimeSpan.FromMinutes(1))
            return Color.Warning;

        return Color.Primary;
    }



}
