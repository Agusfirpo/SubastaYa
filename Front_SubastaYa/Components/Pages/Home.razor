@page "/home"
@using Front_SubastaYa.Services
@inject NavigationManager Navigation
@inject SesionUsuarioService Sesion

<div class="subastaya-root pb-16 flex flex-col justify-between">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 w-full flex-grow">

        <!-- HERO BANNER -->
        <div class="home-banner rounded-3xl overflow-hidden mb-12 shadow-2xl relative">
            <div class="grid grid-cols-1 md:grid-cols-12 items-center min-h-[360px]">

                <!-- Columna Izquierda: Texto -->
                <div class="p-8 sm:p-12 md:p-14 md:col-span-7 z-10">
                    <div class="live-pill inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6">
                        <span class="live-dot"></span>
                        <span class="text-xs font-bold text-blue-200 uppercase tracking-wider">Subastas activas las 24hs</span>
                    </div>

                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
                        Bienvenido a SubastaYa
                    </h1>

                    <p class="text-blue-100/90 text-base sm:text-lg leading-relaxed max-w-lg">
                        Publicá, ofertá y participá en subastas en tiempo real con total transparencia y seguridad garantizada.
                    </p>
                </div>

                <!-- Columna Derecha: Foto integrada -->
                <div class="md:col-span-5 h-full w-full relative min-h-[260px] md:min-h-full">
                    <img src="/imagenes/imagen_baner.png"
                         alt="SubastaYa Banner"
                         class="banner-side-img" />
                    <div class="banner-img-fade"></div>
                </div>

            </div>
        </div>

        <!-- SECCIÓN 1: ¿Qué querés hacer? -->
        <section class="mb-14">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                    <span class="section-indicator-blue"></span>
                    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">¿Qué querés hacer?</h2>
                </div>
                <div class="bg-white/80 backdrop-blur-md hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold text-slate-700 shadow-sm border border-slate-200/60">
                    <span class="material-symbols-outlined text-sm text-blue-600">bolt</span>
                    Acceso directo a funciones principales
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                <div class="home-card" @onclick='() => Navigation.NavigateTo("/subastas")'>
                    <div>
                        <div class="icon-box-blue">
                            <span class="material-symbols-outlined text-2xl text-blue-600">storefront</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Explorar subastas</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Encontrá productos, filtrá resultados por categoría y realizá ofertas en subastas destacadas en vivo.
                        </p>
                    </div>
                    <div class="card-footer-action">
                        <span>Explorar catálogo</span>
                        <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </div>
                </div>

                <div class="home-card" @onclick='() => Navigation.NavigateTo("/crear-subasta")'>
                    <div>
                        <div class="icon-box-blue">
                            <span class="material-symbols-outlined text-2xl text-blue-600">add_circle</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Publicar subasta</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Creá una nueva publicación, subí fotos y configurá el precio base, duración y condiciones de venta.
                        </p>
                    </div>
                    <div class="card-footer-action">
                        <span>Comenzar venta</span>
                        <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </div>
                </div>

                <div class="home-card" @onclick='() => Navigation.NavigateTo("/billetera")'>
                    <div>
                        <div class="icon-box-blue">
                            <span class="material-symbols-outlined text-2xl text-blue-600">account_balance_wallet</span>
                        </div>
                        <h3 class="text-lg font-bold text-slate-900 mb-2">Mi billetera</h3>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            Consultá saldo disponible, fondos en garantía retenidos, transacciones acreditadas y movimientos.
                        </p>
                    </div>
                    <div class="card-footer-action">
                        <span>Ver balances</span>
                        <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN 2: Mi actividad -->
        <section class="mb-14">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                    <span class="section-indicator-slate"></span>
                    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Mi actividad</h2>
                </div>
                <div class="bg-white/80 backdrop-blur-md hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold text-slate-700 shadow-sm border border-slate-200/60">
                    <span class="material-symbols-outlined text-sm text-slate-600">sync_alt</span>
                    Seguimiento de operaciones
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="home-card p-6 flex items-start gap-4" @onclick='() => Navigation.NavigateTo("/mis-publicaciones")'>
                    <div class="icon-box-slate">
                        <span class="material-symbols-outlined text-2xl text-blue-600">inventory_2</span>
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-900">Mis publicaciones</h3>
                        </div>
                        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                            Revisá las subastas que publicaste, preguntas recibidas de interesados y ofertas vigentes.
                        </p>
                        <div class="card-footer-action mt-4 pt-2 border-0">
                            <span>Ir a mis publicaciones</span>
                            <span class="material-symbols-outlined text-base">chevron_right</span>
                        </div>
                    </div>
                </div>

                <div class="home-card p-6 flex items-start gap-4" @onclick='() => Navigation.NavigateTo("/mis-pujas")'>
                    <div class="icon-box-slate">
                        <span class="material-symbols-outlined text-2xl text-blue-600">shopping_bag</span>
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-900">Mis compras / pujas</h3>
                        </div>
                        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                            Consultá las subastas en las que estás participando y el estado de tus ofertas activas y ganadas.
                        </p>
                        <div class="card-footer-action mt-4 pt-2 border-0">
                            <span>Ver mis ofertas</span>
                            <span class="material-symbols-outlined text-base">chevron_right</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <!-- Footer -->
    <footer class="footer-custom py-6 mt-8 text-center">
        <p class="text-sm text-slate-600 font-medium">
            SubastaYa © 2026 • Plataforma de subastas en tiempo real
        </p>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaLogueado)
        {
            await Sesion.CargarSesion();
        }

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
        }
    }
}