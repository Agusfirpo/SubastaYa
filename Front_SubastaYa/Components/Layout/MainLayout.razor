@inherits LayoutComponentBase

<MudThemeProvider Theme="@tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    @* BARRA SUPERIOR *@
    <MudAppBar Elevation="0" Class="app-bar">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="ToggleMenu" />

        <div class="marca">
            <MudIcon Icon="@Icons.Material.Filled.Gavel"
                     Size="Size.Large" />

            <MudText Typo="Typo.h6">
                SubastaYa
            </MudText>
        </div>

        <MudSpacer />

        <MudChip T="string"
                 Icon="@Icons.Material.Filled.Person"
                 Class="usuario-chip">
            Usuario
        </MudChip>

    </MudAppBar>


    @* MENÚ LATERAL *@
    <MudDrawer @bind-Open="menuAbierto"
               Variant="DrawerVariant.Responsive"
               Elevation="0"
               Class="menu-lateral">

        <div class="logo-menu">

            <div class="logo-icono">
                <MudIcon Icon="@Icons.Material.Filled.Gavel"
                         Size="Size.Large" />
            </div>

            <div>
                <MudText Typo="Typo.h5" Class="logo-titulo">
                    SubastaYa
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Subastas online
                </MudText>
            </div>

        </div>

        <MudDivider />

        <MudNavMenu Class="pa-3">

            <MudText Typo="Typo.caption"
                     Class="menu-seccion">
                EXPLORAR
            </MudText>

            <MudNavLink Href="/subastas"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Storefront">
                Subastas
            </MudNavLink>

            <MudNavLink Href="/crear-subasta"
                        Icon="@Icons.Material.Filled.AddCircleOutline">
                Publicar subasta
            </MudNavLink>

            <MudNavLink Href="/billetera"
                        Icon="@Icons.Material.Filled.AccountBalanceWallet">
                Mi billetera
            </MudNavLink>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.caption"
                     Class="menu-seccion">
                MI ACTIVIDAD
            </MudText>

            <MudNavLink Href="/mis-publicaciones"
                        Icon="@Icons.Material.Filled.Inventory2">
                Mis publicaciones
            </MudNavLink>

            <MudNavLink Href="/mis-pujas"
                        Icon="@Icons.Material.Filled.ShoppingBag">
                Mis compras / pujas
            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>


    @* CONTENIDO *@
    <MudMainContent Class="contenido-principal">

        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="pa-6">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>


@code {
    private bool menuAbierto = true;

    private readonly MudTheme tema = new()
    {
        PaletteLight = new PaletteLight
        {
            // AZUL MARINO
            Primary = "#0B1F3A",

            // NARANJA
            Secondary = "#F97316",

            Background = "#F5F7FA",
            Surface = "#FFFFFF",

            AppbarBackground = "#0B1F3A",
            AppbarText = "#FFFFFF",

            TextPrimary = "#172033",
            TextSecondary = "#667085"
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };

    private void ToggleMenu()
        => menuAbierto = !menuAbierto;
}