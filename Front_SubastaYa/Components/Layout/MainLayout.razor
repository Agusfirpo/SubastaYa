@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Front_SubastaYa.Services
@inject SesionUsuarioService Sesion
@inject NavigationManager Navigation
<MudThemeProvider Theme="@tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    @* BARRA SUPERIOR *@
    <MudAppBar Elevation="0" Class="app-bar">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="ToggleMenu" />

        <div class="marca">
            <MudIcon Icon="@Icons.Material.Filled.Gavel"
                     Size="Size.Large" />

            <MudText Typo="Typo.h6">
                SubastaYa
            </MudText>
        </div>

        <MudSpacer />

        @if (sesionCargada)
        {
            @if (Sesion.EstaLogueado)
            {
                <MudMenu Label="@Sesion.Usuario!.Nombre"
                         StartIcon="@Icons.Material.Filled.Person"
                         Color="Color.Inherit">

                    <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                 OnClick="CerrarSesion">
                        Cerrar sesión
                    </MudMenuItem>

                </MudMenu>
            }
            else
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/login">
                    Ingresar
                </MudButton>
            }
        }

    </MudAppBar>


    @* MENÚ LATERAL *@
    <MudDrawer @bind-Open="menuAbierto"
               Variant="DrawerVariant.Responsive"
               Elevation="0"
               Class="menu-lateral">

        <div class="logo-menu">

            <div class="logo-subastaya"
                 @onclick="@(() => Navigation.NavigateTo("/home"))">

                <MudIcon Icon="@Icons.Material.Filled.Gavel"
                         Size="Size.Large" />

                <MudText Typo="Typo.h6">
                    SubastaYa
                </MudText>

            </div>

            <div>
                <MudText Typo="Typo.h5" Class="logo-titulo">
                    SubastaYa
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Subastas online
                </MudText>
            </div>

        </div>

        <MudDivider />

        <MudNavMenu Class="pa-3">

            <MudText Typo="Typo.caption"
                     Class="menu-seccion">
                EXPLORAR
            </MudText>

            <MudNavLink Href="/subastas"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Storefront">
                Subastas
            </MudNavLink>

            <MudNavLink Href="/crear-subasta"
                        Icon="@Icons.Material.Filled.AddCircleOutline">
                Publicar subasta
            </MudNavLink>

            <MudNavLink Href="/billetera"
                        Icon="@Icons.Material.Filled.AccountBalanceWallet">
                Mi billetera
            </MudNavLink>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.caption"
                     Class="menu-seccion">
                MI ACTIVIDAD
            </MudText>

            <MudNavLink Href="/mis-publicaciones"
                        Icon="@Icons.Material.Filled.Inventory2">
                Mis publicaciones
            </MudNavLink>

            <MudNavLink Href="/mis-pujas"
                        Icon="@Icons.Material.Filled.ShoppingBag">
                Mis compras / pujas
            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>


    @* CONTENIDO *@
    <MudMainContent Class="contenido-principal">

        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="pa-6">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>


@code {
    private bool menuAbierto = true;

    private readonly MudTheme tema = new()
    {
        PaletteLight = new PaletteLight
        {
            // AZUL MARINO
            Primary = "#0B1F3A",

            // NARANJA
            Secondary = "#F97316",

            Background = "#F5F7FA",
            Surface = "#FFFFFF",

            AppbarBackground = "#0B1F3A",
            AppbarText = "#FFFFFF",

            TextPrimary = "#172033",
            TextSecondary = "#667085"
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px"
        }
    };

    private bool sesionCargada;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarSesion();
        sesionCargada = true;
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesion();
        Navigation.NavigateTo("/login");
    }

    private void ToggleMenu()
        => menuAbierto = !menuAbierto;
}