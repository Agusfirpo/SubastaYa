@page "/mis-pujas"

@using System.Net.Http.Json
@using Application.DTOs.Response
@using Front_AuctionNow.Services

@inject UserSessionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8 pb-16">
    <!-- TÍTULO DE LA SECCIÓN -->
    <section class="mb-6">
        <MudText Typo="Typo.h4" Class="font-extrabold tracking-tight text-slate-900">
            Mis compras / pujas
        </MudText>
        <MudText Typo="Typo.subtitle2" Class="font-semibold text-orange-600 mt-1 tracking-wide">
            Subastas en las que participaste
        </MudText>
    </section>

    <!-- BOTÓN DE CONSULTA -->
    <div class="mb-6">
        <button class="btn-consultar" type="button" @onclick="Cargar">
            CONSULTAR
        </button>
    </div>

    <!-- TABLA DE RESULTADOS -->
    <div class="w-full bg-white border border-slate-200/90 rounded-xl overflow-hidden shadow-sm">
        @if (cargando)
        {
            <div class="d-flex justify-center items-center py-12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else if (participaciones.Count == 0)
        {
            <div class="p-6">
                <MudAlert Severity="Severity.Info" Class="rounded-lg">
                    El usuario todavía no participó en subastas.
                </MudAlert>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200/80 bg-slate-50/60 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-6">Subasta</th>
                            <th class="py-3.5 px-6">Mi puja</th>
                            <th class="py-3.5 px-6">Puja actual</th>
                            <th class="py-3.5 px-6">Resultado</th>
                            <th class="py-3.5 px-6">Finaliza</th>
                            <th class="py-3.5 px-6 text-right"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                        @foreach (var context in participaciones)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors duration-150">
                                <td class="py-4 px-6 align-middle">
                                    <div class="font-bold text-slate-900 tracking-tight">@context.Titulo</div>
                                    <div class="text-xs text-slate-400 font-normal mt-0.5">@context.EstadoSubasta</div>
                                </td>
                                <td class="py-4 px-6 align-middle font-mono font-medium text-slate-800 whitespace-nowrap">
                                    $ @context.MiUltimaPuja.ToString("N2")
                                </td>
                                <td class="py-4 px-6 align-middle font-mono font-medium text-slate-800 whitespace-nowrap">
                                    $ @context.PujaActual.ToString("N2")
                                </td>
                                <td class="py-4 px-6 align-middle whitespace-nowrap">
                                    @if (context.Resultado == "Ganada" || context.Resultado == "Liderando")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-teal-500/10 text-teal-700 border border-teal-500/20">
                                            @context.Resultado
                                        </span>
                                    }
                                    else if (context.Resultado == "Superado")
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium tracking-wide bg-amber-500/10 text-amber-700 border border-amber-500/20">
                                            @context.Resultado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium tracking-wide bg-slate-100 text-slate-600 border border-slate-200">
                                            @context.Resultado
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 align-middle font-mono text-slate-500 whitespace-nowrap text-xs">
                                    @context.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="py-4 px-6 align-middle text-right whitespace-nowrap">
                                    <button class="inline-flex items-center text-xs font-bold text-slate-400 hover:text-blue-600 tracking-wider transition-colors duration-150 group"
                                            @onclick="@(() => Ver(context.SubastaId))">
                                        VER
                                        <svg class="w-3.5 h-3.5 ml-1 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                            <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</MudContainer>

@code {
    private int usuarioId => Sesion.Usuario?.Id ?? 0;
    private bool cargando;
    private IList<ParticipationResponse> participaciones = [];

    protected override async Task OnInitializedAsync()
    {
        // 1. Restaurar sesión si el usuario presionó F5
        if (!Sesion.EstaLogueado)
        {
            await Sesion.CargarSesion();
        }

        // 2. Si no hay sesión válida, enviar al login
        if (!Sesion.EstaLogueado || usuarioId <= 0)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // 3. Ejecutar la carga con el ID correcto
        await Cargar();
    }

    private async Task Cargar()
    {
        if (usuarioId <= 0) return;

        cargando = true;

        try
        {
            participaciones = await Http.GetFromJsonAsync<IList<ParticipationResponse>>(
                $"api/v1/usuarios/{usuarioId}/pujas") ?? [];
        }
        catch
        {
            participaciones = [];
            Snackbar.Add("No se pudieron cargar las pujas.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void Ver(int id)
        => Navigation.NavigateTo($"/subastas/{id}");

    private Color ColorResultado(string resultado) => resultado switch
    {
        "Ganada" => Color.Success,
        "Liderando" => Color.Success,
        "Superado" => Color.Warning,
        _ => Color.Default
    };
}