@page "/"
@page "/login"

@using System.Net.Http.Json
@using Application.DTOs.Request
@using Application.DTOs.Response
@using Front_AuctionNow.Services
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject UserSessionService Sesion
@inject ISnackbar Snackbar

<div class="login-background">
    <MudContainer MaxWidth="MaxWidth.Small" Class="login-container">
        <MudPaper Class="pa-6 login-card" Elevation="2">

            <div class="login-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Primary" Size="Size.Medium" />
            </div>

            <MudText Typo="Typo.h4" Class="mb-1">
                Iniciar sesión
            </MudText>

            <MudTextField T="string"
                          Label="Email"
                          Placeholder="nombre@ejemplo.com"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Variant="Variant.Outlined"
                          @bind-Value="email"
                          Class="mb-3" />

            <MudTextField T="string"
                          Label="Contraseña"
                          Placeholder="********"
                          InputType="@(mostrarPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(mostrarPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => mostrarPassword = !mostrarPassword)"
                          Variant="Variant.Outlined"
                          @bind-Value="password"
                          Class="mb-2" />

            <div class="login-options-row mb-4">
                <MudCheckBox T="bool" @bind-Value="recordarme" Label="Recordarme" Dense="true" />
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@cargando"
                       OnClick="login">
                @(cargando ? "Ingresando..." : "Ingresar")
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Storefront"
                       OnClick="@(() => Navigation.NavigateTo("/subastas"))">
                Ver subastas
            </MudButton>

        </MudPaper>
    </MudContainer>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool cargando;
    private bool mostrarPassword = false;
    private bool recordarme = false;

    private void IrAOlvideContraseña() => Navigation.NavigateTo("/olvide-password");

    private async Task login()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            Snackbar.Add("Ingresá email y contraseña.", Severity.Warning);
            return;
        }

        cargando = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/usuarios/login", new LoginRequest
            {
                Email = email,
                Password = password
            });

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Email o contraseña incorrectos.", Severity.Error);
                return;
            }

            var usuario = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (usuario == null) return;

            await Sesion.IniciarSesion(usuario);
            Navigation.NavigateTo("/home", forceLoad: false); // Carga inmediata
        }
        catch
        {
            Snackbar.Add("No se pudo conectar con la API.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }
}