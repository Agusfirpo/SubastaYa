@page "/subastas"

@using System.Net.Http.Json
@using Application.DTOs.Response
@using Front_AuctionNow.Components
@using Front_AuctionNow.Services

@inject UserSessionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="subastas-background" style="background-image: url('imagenes/pexels-codioful-7130565.jpg');">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">

        <!-- CABECERA DE LA PÁGINA -->
        <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <div class="header-chip">
                    <span class="pulse-dot"></span>
                    Mercado En Tiempo Real
                </div>
                <MudText Typo="Typo.h3" Class="font-extrabold tracking-tight text-slate-900">
                    Catálogo de Subastas
                </MudText>
                <MudText Typo="Typo.body1" Class="text-slate-500">
                    Encontrá, seguí y participá en pujas garantizadas en vivo.
                </MudText>
            </div>

            @if (resultado != null)
            {
                <div class="flex items-center gap-2">
                    <div class="stats-badge">
                        <span class="active-dot"></span>
                        <span class="text-xs text-slate-600 font-medium">
                            @resultado.TotalItems subastas registradas
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- PANEL DE FILTROS -->
        <MudPaper Class="pa-4 mb-6 rounded-2xl bg-white/90 backdrop-blur-md shadow-sm border border-slate-200/80" Elevation="0">
            <MudGrid Spacing="2">

                <!-- Buscar con Autocompletado Reactivo -->
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string"
                                     Label="Buscar lote"
                                     Placeholder="Título o número de lote..."
                                     Value="busqueda"
                                     ValueChanged="OnBusquedaChanged"
                                     SearchFunc="BuscarSugerencias"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     MaxItems="8"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     Class="bg-slate-50 rounded-xl" />
                </MudItem>

                <!-- Estado (Vacío por defecto para mostrar todas) -->
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string"
                               Label="Estado"
                               Variant="Variant.Outlined"
                               @bind-Value="estado"
                               Clearable="true"
                               Class="bg-slate-50 rounded-xl">
                        <MudSelectItem Value="@("Activa")">Activa</MudSelectItem>
                        <MudSelectItem Value="@("Programada")">Programada</MudSelectItem>
                        <MudSelectItem Value="@("Finalizada")">Finalizada</MudSelectItem>
                        <MudSelectItem Value="@("Desierta")">Desierta</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Categoría -->
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               Label="Categoría"
                               Variant="Variant.Outlined"
                               @bind-Value="categoriaId"
                               Clearable="true"
                               Class="bg-slate-50 rounded-xl">
                        @foreach (var categoria in categorias)
                        {
                            <MudSelectItem T="int?" Value="@((int?)categoria.Id)">
                                @categoria.Nombre
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Ordenar -->
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string"
                               Label="Ordenar por"
                               Variant="Variant.Outlined"
                               @bind-Value="orden"
                               Clearable="true"
                               Class="bg-slate-50 rounded-xl">
                        <MudSelectItem Value="@("tiempo")">Menor tiempo restante</MudSelectItem>
                        <MudSelectItem Value="@("puja")">Mayor puja actual</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Precio Mínimo -->
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     Label="Precio mínimo"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     @bind-Value="precioMinimo"
                                     Class="bg-slate-50 rounded-xl" />
                </MudItem>

                <!-- Precio Máximo -->
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     Label="Precio máximo"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$"
                                     @bind-Value="precioMaximo"
                                     Class="bg-slate-50 rounded-xl" />
                </MudItem>

                <!-- Botones de Acción -->
                <MudItem xs="12" md="6" Class="d-flex justify-end items-center gap-2 pt-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="LimpiarFiltros"
                               Class="rounded-xl px-4">
                        Limpiar
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Tune"
                               OnClick="AplicarFiltros"
                               Class="rounded-xl px-6 font-bold shadow-md">
                        Aplicar filtros
                    </MudButton>
                </MudItem>

            </MudGrid>
        </MudPaper>

        <!-- RESULTADOS -->
        @if (cargando && resultado == null)
        {
            <div class="d-flex justify-center items-center py-16">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            </div>
        }
        else if (resultado == null || resultado.Items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="rounded-xl border border-blue-200">
                No se encontraron subastas con los filtros seleccionados.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var subasta in resultado.Items)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <article class="subasta-card">

                            <!-- CONTENEDOR DE IMAGEN ROBUSTO -->
                            <div class="relative w-full h-48 bg-slate-100/80 overflow-hidden flex items-center justify-center border-b border-slate-100">
                                @if (!string.IsNullOrWhiteSpace(subasta.UrlImagen))
                                {
                                    <img src="@subasta.UrlImagen"
                                         alt=""
                                         class="w-full h-full object-cover"
                                         loading="lazy"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <!-- Fallback si la imagen no carga o da error -->
                                    <div class="hidden w-full h-full flex flex-col items-center justify-center bg-slate-100 text-slate-400 select-none">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="text-slate-300" />
                                        <span class="text-[10px] font-semibold text-slate-400 mt-1 uppercase tracking-wider">Sin imagen</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="w-full h-full flex flex-col items-center justify-center bg-slate-100 text-slate-400 select-none">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="text-slate-300" />
                                        <span class="text-[10px] font-semibold text-slate-400 mt-1 uppercase tracking-wider">Sin imagen</span>
                                    </div>
                                }

                                <!-- Badges Superpuestos -->
                                <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold text-white shadow-sm"
                                     style="background-color: @GetEstadoBgColor(subasta.Estado);">
                                    @if (subasta.Estado == "Activa")
                                    {
                                        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    }
                                    <span>@subasta.Estado</span>
                                </div>

                                <div class="absolute bottom-3 left-3 px-2.5 py-1 rounded-md text-[11px] font-bold text-slate-700 bg-white/95 backdrop-blur-md border border-white/80 shadow-xs">
                                    @subasta.Categoria
                                </div>
                            </div>

                            <!-- CONTENIDO DE LA TARJETA -->
                            <div class="p-5 flex flex-col flex-1 justify-between gap-4">
                                <div class="space-y-2">
                                    <div class="flex items-center justify-between text-xs text-slate-500">
                                        <span class="font-bold text-slate-700">Lote #@subasta.Id</span>
                                        <span class="pujas-badge">
                                            <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Small" />
                                            @subasta.CantidadPujas @(subasta.CantidadPujas == 1 ? "puja" : "pujas")
                                        </span>
                                    </div>

                                    <h3 class="card-title">
                                        @subasta.Titulo
                                    </h3>
                                </div>

                                <!-- PRECIOS -->
                                <div class="precios-container">
                                    <div class="flex justify-between items-center text-xs text-slate-500">
                                        <span>Precio base:</span>
                                        <span class="line-through font-semibold">$ @subasta.PrecioBase.ToString("N2")</span>
                                    </div>
                                    <div class="flex justify-between items-baseline">
                                        <span class="text-xs font-bold text-blue-600">Puja actual:</span>
                                        <span class="text-lg font-black text-blue-700">$ @subasta.PujaActual.ToString("N2")</span>
                                    </div>
                                </div>

                                <!-- CONTADOR CON SEMÁFORO -->
                                <div class="pt-1">
                                    <ContadorSubasta FechaInicio="@subasta.FechaInicio"
                                                     FechaFin="@subasta.FechaFin"
                                                     Estado="@subasta.Estado"
                                                     OnTiempoCumplido="RefrescarEstado" />
                                </div>

                                <!-- BOTÓN ACCIÓN -->
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => VerSubasta(subasta.Id))"
                                           Class="rounded-xl py-2.5 font-bold shadow-md">
                                    Ver subasta
                                </MudButton>
                            </div>

                        </article>
                    </MudItem>
                }
            </MudGrid>

            <!-- PAGINACIÓN -->
            @if (resultado.TotalPaginas > 1)
            {
                <div class="d-flex justify-center mt-8 mb-6">
                    <MudPagination Count="@resultado.TotalPaginas"
                                   Selected="@pagina"
                                   SelectedChanged="CambiarPagina"
                                   ShowFirstButton="true"
                                   ShowLastButton="true"
                                   Color="Color.Primary"
                                   Class="rounded-xl bg-white p-2 shadow-sm border border-slate-200" />
                </div>
            }
        }
    </MudContainer>
</div>

<!-- MODAL GLASSMORPHISM -->
@if (mostrarModalAuth)
{
    <div class="auth-modal-overlay">
        <div class="auth-modal-card">
            <div aria-hidden="true" class="auth-modal-glow"></div>

            <button aria-label="Cerrar modal"
                    class="auth-modal-close-btn"
                    type="button"
                    @onclick="() => mostrarModalAuth = false">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>

            <div class="auth-modal-icon-container">
                <div class="auth-modal-icon-wrapper">
                    <div class="auth-modal-icon-box">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Size="Size.Large" />
                    </div>
                    <span class="auth-modal-lock-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 11px;" />
                    </span>
                </div>
            </div>

            <div class="auth-modal-text-group">
                <h3 class="auth-modal-title">
                    Inicio de sesión requerido
                </h3>
                <p class="auth-modal-description">
                    Para ingresar a una subasta tenés que iniciar sesión.
                </p>
                <p class="auth-modal-subtext">
                    Identificate para realizar ofertas seguras en vivo y administrar tu saldo.
                </p>
            </div>

            <div class="auth-modal-actions">
                <button type="button"
                        class="auth-btn-secondary"
                        @onclick="() => mostrarModalAuth = false">
                    Seguir mirando
                </button>

                <button type="button"
                        class="auth-btn-primary"
                        @onclick='() => Navigation.NavigateTo("/login")'>
                    <span>Iniciar sesión</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </button>
            </div>

            <div class="auth-modal-footer">
                <p class="auth-modal-footer-text">
                    ¿No tenés cuenta aún?
                    <a class="auth-modal-register-link"
                       @onclick='() => Navigation.NavigateTo("/registro")'>
                        Registrate gratis
                    </a>
                </p>
            </div>
        </div>
    </div>
}

@code {
    private PagedAuctionsResponse? resultado;
    private IList<CategoryResponse> categorias = [];
    private List<string> titulosSugerencias = [];

    private bool cargando;
    private bool mostrarModalAuth = false;

    // null por defecto: trae todas las subastas registradas sin importar su estado
    private string? estado = null;
    private string? orden, busqueda;
    private int? categoriaId;
    private decimal? precioMinimo, precioMaximo;

    private int pagina = 1;
    private const int tamanioPagina = 6;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaLogueado)
        {
            await Sesion.CargarSesion();
        }

        await Task.WhenAll(CargarCategorias(), CargarSubastas());
    }

    private async Task OnBusquedaChanged(string? nuevoValor)
    {
        busqueda = nuevoValor;
        if (string.IsNullOrWhiteSpace(busqueda))
        {
            pagina = 1;
            await CargarSubastas();
        }
    }

    private async Task<IEnumerable<string>> BuscarSugerencias(string valor, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return titulosSugerencias.Take(6);

        var filtro = valor.Trim().ToLowerInvariant();

        return await Task.FromResult(
            titulosSugerencias
                .Where(t => t.ToLowerInvariant().Contains(filtro))
                .Distinct()
        );
    }

    private async Task CargarCategorias()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<IList<CategoryResponse>>("api/v1/categorias") ?? [];
        }
        catch
        {
            Snackbar.Add("No se pudieron cargar las categorías.", Severity.Error);
        }
    }

    private async Task CargarSubastas()
    {
        cargando = true;

        try
        {
            var url = $"api/v1/subastas?pagina={pagina}&tamanioPagina={tamanioPagina}";

            if (!string.IsNullOrWhiteSpace(busqueda))
                url += $"&busqueda={Uri.EscapeDataString(busqueda)}";

            if (!string.IsNullOrWhiteSpace(estado))
                url += $"&estado={Uri.EscapeDataString(estado)}";

            if (categoriaId.HasValue)
                url += $"&categoriaId={categoriaId}";

            if (precioMinimo.HasValue)
                url += $"&precioMinimo={precioMinimo}";

            if (precioMaximo.HasValue)
                url += $"&precioMaximo={precioMaximo}";

            if (!string.IsNullOrWhiteSpace(orden))
                url += $"&orden={Uri.EscapeDataString(orden)}";

            resultado = await Http.GetFromJsonAsync<PagedAuctionsResponse>(url);

            if (resultado?.Items != null)
            {
                foreach (var item in resultado.Items.Where(i => !string.IsNullOrEmpty(i.Titulo)))
                {
                    if (!titulosSugerencias.Contains(item.Titulo))
                        titulosSugerencias.Add(item.Titulo);
                }
            }
        }
        catch
        {
            resultado = null;
            Snackbar.Add("No se pudieron cargar las subastas.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task AplicarFiltros()
    {
        pagina = 1;
        await CargarSubastas();
    }

    private async Task LimpiarFiltros()
    {
        estado = orden = busqueda = null;
        categoriaId = null;
        precioMinimo = precioMaximo = null;
        pagina = 1;

        await CargarSubastas();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        pagina = nuevaPagina;
        await CargarSubastas();
    }

    private async Task RefrescarEstado()
    {
        await Task.Delay(1500);
        await CargarSubastas();
    }

    private void VerSubasta(int id)
    {
        if (Sesion.EstaLogueado)
        {
            Navigation.NavigateTo($"/subastas/{id}");
            return;
        }

        mostrarModalAuth = true;
    }

    private static Color ObtenerColorEstado(string estado) => estado switch
    {
        "Activa" => Color.Success,
        "Programada" => Color.Info,
        "Desierta" => Color.Warning,
        _ => Color.Default
    };

    private static string GetEstadoBgColor(string estado) => estado switch
    {
        "Activa" => "#059669",
        "Programada" => "#2563eb",
        "Desierta" => "#d97706",
        _ => "#64748b"
    };
}